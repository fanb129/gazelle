\newlabel{fig:motivation}{{1}{1}{Motivation. Decoding only the final VFM layer can draw the response toward a salient distractor in a crowded scene. GazeSpot instead combines multiple feature levels with a head-conditioned Spotlight Mask, yielding a more concentrated response near the annotated target}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces GazeSpot extracts four levels from a frozen VFM. HCSG applies a head-conditioned Spotlight Mask to each level, SASA fuses the gated features with image-dependent weights, and a lightweight decoder predicts the gaze heatmap and the in/out-of-frame score.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{2}{GazeSpot extracts four levels from a frozen VFM. HCSG applies a head-conditioned Spotlight Mask to each level, SASA fuses the gated features with image-dependent weights, and a lightweight decoder predicts the gaze heatmap and the in/out-of-frame score}{figure.2}{}}

          2,
          5,
          8,
          11
        ],
        "l": [
          5,
          11,
          17,
          23
        ]
      },
      "flow": "Dense prefix -> head-conditioned support + max-union -> TopK -> sparse suffix -> early-exit fill -> four-map concat/project -> GazeLLE-style per-person decoder",
      "sources": [
        "gazelle/routing/model.py",
        "gazelle/routing/backbone.py",
        "gazelle/model.py"

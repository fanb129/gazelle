      "evidence": "forward_features x_norm_patchtokens, original GAZELLE-style API aliases, head-map prompt and shared scene features. Layer-wise text supervision is decoder supervision, not multi-depth DINO fusion."
    },
    {
      "id": "gazehrnet",
      "lineage": "GazeLLE_style_structural_extension_not_checkpoint_reuse_proof",
      "backbone": "DINOv2 final patch map",
      "backbone_depth_fusion": false,
      "flow": "Final map -> project 256 -> GRSP -> per-person repeat -> head-centric polar encoding + head prompt + GAZE token -> 3 HAAR blocks -> heatmap/in-out plus patch-distribution head",

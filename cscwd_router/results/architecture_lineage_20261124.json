      "backbone_depth_fusion": true,
      "feature_blocks_zero_based": null,
      "flow": "RGB + offline YOLO11x/SAM2 masks -> image/object token interaction -> enhanced representation -> DINOv3 shallow/middle/deep maps -> deep-dominant residual fusion; head appearance + eye position -> direction/FOV -> guided decoder -> heatmap/in-out",
      "sources": [
        "https://arxiv.org/html/2606.29334v1"

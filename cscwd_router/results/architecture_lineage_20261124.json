{
  "research_date": "2026-11-24",
  "task": "SOTA-2 architecture and GazeLLE lineage",
  "new_training_or_gpu_inference": false,
  "definition": {
    "gazelle_style": "Shared scene encoder, per-person head-position conditioning, lightweight spatial decoder. Structural similarity is distinguished from explicit author-acknowledged derivation or checkpoint reuse.",
    "multi_layer_features": "Fuse outputs/attention from multiple backbone depths; not simply a multi-block decoder, multiple input branches or layer-wise losses."
  },
  "models": [
    {
      "id": "gazelle_official",
      "lineage": "original",
      "backbone": "DINOv2 ViT-B/14 or ViT-L/14",
      "backbone_depth_fusion": false,
      "flow": "RGB -> final patch map -> 1x1 projection 256 -> head-region embedding + 2D position -> 3 ViT blocks -> heatmap / in-out",
      "sources": [
        "https://github.com/fkryan/gazelle"
      ],
      "evidence": "Local official model_v0_dinov2.py and backbone_v0_dinov2.py; official repository."
    },
    {

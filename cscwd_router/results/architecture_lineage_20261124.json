      "backbone_depth_fusion": false,
      "flow": "Final patch map -> project 256 + head embedding; Qwen2.5-VL captions -> frozen BERT -> 64 text tokens -> 3-layer vision-text Transformer -> visual residual -> heatmap/in-out",

# Keep small reports despite the repository-wide JSON ignore rule.
!/results/**/*.json
!/results/*.json

# Portable, small paper cases and CPU render provenance.
!/latex/figures/final_seed0/assets/
!/latex/figures/final_seed0/assets/*.jpg
!/latex/figures/final_seed0/*.json
!/latex/figures/final_inframe3_seed0/assets/
!/latex/figures/final_inframe3_seed0/assets/*.jpg
!/latex/figures/final_inframe3_seed0/*.json

# Large artifacts remain on the server.
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.pkl
*.parquet
*.zip
code/cache/
results/cache/
__pycache__/
*.pyc
.DS_Store

